---
interface Props {
  headline: string;
  body?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const { headline, body, primary, secondary } = Astro.props;
---

<section class="section-major">
  <div class="mx-auto max-w-site px-5 text-center md:px-8">
    <h2 class="text-tp-heading mx-auto max-w-[640px] text-balance reveal">{headline}</h2>
    {body ? <p class="text-tp-desc mx-auto mt-5 max-w-[480px] reveal" style="--i:1">{body}</p> : null}
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 reveal" style="--i:2">
      <a class="btn btn-primary btn-lg" href={primary.href}>{primary.label}</a>
      {secondary ? <a class="btn btn-secondary btn-lg" href={secondary.href}>{secondary.label}</a> : null}
    </div>
  </div>
</section>
