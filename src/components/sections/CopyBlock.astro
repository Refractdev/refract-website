---
interface Props {
  id?: string;
  headline: string;
}

const { id, headline } = Astro.props;
---

<section id={id} class="section-major">
  <div class="mx-auto max-w-site px-5 text-center md:px-8">
    <h2 class="text-tp-heading mx-auto max-w-[720px] text-balance reveal">{headline}</h2>
    <div class="prose-copy mx-auto mt-6 max-w-[560px] reveal" style="--i:1">
      <slot />
    </div>
  </div>
</section>
