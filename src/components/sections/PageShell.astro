---
interface Props {
  label?: string;
  title: string;
  description?: string;
  maxWidth?: number;
  stage?: string;
}

const { label, title, description, maxWidth = 720, stage } = Astro.props;
---

<main id="main" class="page-shell min-h-screen bg-ld-canvas pt-28 pb-20 text-ld-secondary">
  {
    stage ? (
      <div class="page-stage" aria-hidden="true">
        <img src={stage} alt="" width="1024" height="791" />
      </div>
    ) : null
  }
  <div class="page-shell__inner mx-auto px-5" style={`max-width:${maxWidth}px`}>
    <header class="anim-hero mb-12">
      {label ? <p class="tp-section-label">{label}</p> : null}
      <h1 class="text-tp-heading mt-3">{title}</h1>
      {description ? <div class="text-tp-desc mt-3 max-w-[560px]">{description}</div> : null}
    </header>
    <div class="space-y-6 text-[15px] font-normal text-ld-tertiary">
      <slot />
    </div>
  </div>
</main>
