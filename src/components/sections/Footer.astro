---
import Logo from '@/components/ui/Logo.astro';
import { footerBrandLine, footerFinePrint, footerSections, githubAppLink } from '@/content/nav';

const year = new Date().getFullYear();
---

<footer class="pt-16 pb-14 md:pt-11 md:pb-10">
  <div class="mx-auto max-w-site px-5 md:px-6">
    <div class="mb-12">
      <Logo height={16} />
      <p class="mt-3 text-[13px] text-ld-muted">{footerBrandLine}</p>
    </div>

    <div class="grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3">
      {
        footerSections.map((section) => (
          <div>
            <h3 class="mb-3 text-[14px] font-normal tracking-[0.01em] text-white">{section.title}</h3>
            <ul class="flex flex-col gap-2.5">
              {section.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[14px] font-normal tracking-[0.01em] text-ld-muted transition-colors hover:text-ld-secondary">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h3 class="mb-3 text-[14px] font-normal tracking-[0.01em] text-white">GitHub</h3>
        <a
          href={githubAppLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[14px] font-normal tracking-[0.01em] text-ld-muted transition-colors hover:text-ld-secondary"
        >
          {githubAppLink.label}
        </a>
      </div>
    </div>

    <div class="tp-divider my-8 md:my-10"></div>

    <div class="flex flex-col gap-3 text-[13px] text-ld-muted md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} Refract. All rights reserved.</p>
      <p>{footerFinePrint}</p>
    </div>
    <p class="mt-3 text-[13px] text-ld-muted">
      We use what we need to run the product. See <a href="/privacy" class="text-ld-secondary underline underline-offset-2">Privacy</a>.
    </p>
  </div>
</footer>
