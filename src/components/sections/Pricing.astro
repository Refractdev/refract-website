---
import PlanGrid from '@/components/sections/PlanGrid.astro';
import { individualPlans, pricingFootnote, pricingHero, teamPlans } from '@/content/pricing';
---

<section id="pricing" class="pricing-root relative pb-8">
  <input type="radio" name="billing" id="billing-monthly" checked />
  <input type="radio" name="billing" id="billing-yearly" />

  <div class="mx-auto max-w-site px-5 md:px-6">
    <div class="rounded-lg border border-ld-border bg-ld-surface px-5 py-4 text-[14px] leading-relaxed text-ld-tertiary">
      {pricingHero.banner}
    </div>

    <div class="mt-8 flex items-center justify-center">
      <div class="billing-switch" role="group" aria-label="Billing period">
        <label for="billing-monthly">Monthly</label>
        <label for="billing-yearly">
          Yearly <span class="save">2 months free</span>
        </label>
      </div>
    </div>

    <h2 class="text-h3 mt-14 reveal">Individuals</h2>
    <PlanGrid plans={individualPlans} />

    <h2 class="text-h3 mt-16 reveal">For teams</h2>
    <PlanGrid plans={teamPlans} />

    <p class="mt-10 max-w-[720px] text-[13px] leading-relaxed text-ld-muted reveal">{pricingFootnote}</p>
  </div>
</section>
