---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../layouts/AppShell.astro';
import Hero from '@/components/sections/Hero.astro';
import CopyBlock from '@/components/sections/CopyBlock.astro';
import CTA from '@/components/sections/CTA.astro';
import ResultNote from '@/components/sections/ResultNote.astro';
import Transform from '@/components/code/Transform.astro';
import Band from '@/components/ui/Band.astro';
import Bento from '@/components/ui/Bento.astro';
import Tile from '@/components/ui/Tile.astro';
import ArtDuplicate from '@/components/art/ArtDuplicate.astro';
import ArtFetch from '@/components/art/ArtFetch.astro';
import ArtLeftover from '@/components/art/ArtLeftover.astro';
import ArtStructure from '@/components/art/ArtStructure.astro';
import ArtApprove from '@/components/art/ArtApprove.astro';
import ArtOrder from '@/components/art/ArtOrder.astro';
import ArtCheck from '@/components/art/ArtCheck.astro';
import ArtProject from '@/components/art/ArtProject.astro';
import ArtQuiet from '@/components/art/ArtQuiet.astro';
import ArtDiff from '@/components/art/ArtDiff.astro';
import ArtMess from '@/components/art/ArtMess.astro';
import ArtCleanup from '@/components/art/ArtCleanup.astro';
import ArtConnect from '@/components/art/ArtConnect.astro';
import ArtRefuse from '@/components/art/ArtRefuse.astro';
import ArtScope from '@/components/art/ArtScope.astro';
import ArtStep from '@/components/art/ArtStep.astro';
import ArtAudience from '@/components/art/ArtAudience.astro';
import { heroFilm } from '@/content/home';
import { usePack } from '@/i18n/usePack';

const { pack, href } = usePack(Astro.url.pathname);
const { home, product } = pack;
const stepKinds = ['account', 'connect', 'ship'] as const;
const audienceKinds = ['individual', 'team', 'stack'] as const;
const worldStates = [
  { title: product.results.items[1].title, body: product.results.items[1].body },
  { title: product.results.items[2].title, body: product.results.items[2].body, action: product.results.items[2].title },
  { title: product.results.items[3].title, body: product.results.items[3].body },
];
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  ogTitle={home.seo.ogTitle}
  ogDescription={home.seo.ogDescription}
  includeProduct
>
  <AppShell>
    <main id="main">
      <Hero />

      <section class="pb-4 md:pb-6">
        <div class="mx-auto max-w-site px-5 md:px-8">
          <Bento>
            <Tile title={home.problem.bullets[0]} span={6} rows={2} index={0}>
              <ArtDuplicate slot="art" />
            </Tile>
            <Tile title={home.problem.bullets[1]} span={6} index={1}>
              <ArtFetch slot="art" />
            </Tile>
            <Tile title={home.problem.bullets[2]} span={3} index={2}>
              <ArtLeftover slot="art" />
            </Tile>
            <Tile title={home.problem.bullets[3]} span={3} index={3}>
              <ArtStructure slot="art" />
            </Tile>
          </Bento>
          <p class="band__after reveal" style="--i:1">
            {home.problem.headline} {home.problem.close}
          </p>
        </div>
      </section>

      <Band headline={home.turn.headline} lede={home.turn.lede}>
        <Bento>
          <Tile span={12} index={0}>
            <Transform slot="art" file={heroFilm.file} lines={heroFilm.lines} caption={home.hero.caption} />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.result.headline}>
        <Bento>
          <Tile title={home.result.points[0].title} body={home.result.points[0].body} span={8} index={0}>
            <ArtDiff slot="art" kind="remove" />
          </Tile>
          <Tile title={home.result.points[1].title} body={home.result.points[1].body} span={4} index={1}>
            <ArtDiff slot="art" kind="merge" />
          </Tile>
          <Tile title={home.result.points[2].title} body={home.result.points[2].body} span={4} index={2}>
            <ArtDiff slot="art" kind="add" />
          </Tile>
          <Tile title={home.result.points[3].title} body={home.result.points[3].body} span={8} index={3}>
            <ArtDiff slot="art" kind="lock" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.does.headline}>
        <Bento>
          <Tile kicker={home.does.points[0].number} title={home.does.points[0].title} body={home.does.points[0].body} span={5} index={0}>
            <ArtProject slot="art" />
          </Tile>
          <Tile kicker={home.does.points[1].number} title={home.does.points[1].title} body={home.does.points[1].body} span={7} index={1}>
            <ArtMess slot="art" />
          </Tile>
          <Tile kicker={home.does.points[2].number} title={home.does.points[2].title} body={home.does.points[2].body} span={7} index={2}>
            <ArtOrder slot="art" />
          </Tile>
          <Tile kicker={home.does.points[3].number} title={home.does.points[3].title} body={home.does.points[3].body} span={5} index={3}>
            <ArtCleanup slot="art" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.world.headline} lede={home.world.lede} after={home.world.close}>
        <Bento>
          <Tile span={8} body={home.world.caption} index={0}>
            <ResultNote slot="art" states={worldStates} primaryIndex={1} />
          </Tile>
          <Tile body={home.world.decide} span={4} index={1}>
            <ArtConnect slot="art" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.trust.headline}>
        <Bento>
          <Tile title={home.trust.points[0].title} body={home.trust.points[0].body} span={7} size="tall" index={0}>
            <ArtApprove slot="art" />
          </Tile>
          <Tile title={home.trust.points[1].title} body={home.trust.points[1].body} span={5} size="tall" index={1}>
            <ArtQuiet slot="art" />
          </Tile>
          <Tile title={home.trust.points[2].title} body={home.trust.points[2].body} span={4} index={2}>
            <ArtRefuse slot="art" />
          </Tile>
          <Tile title={home.trust.points[3].title} body={home.trust.points[3].body} span={4} index={3}>
            <ArtCheck slot="art" />
          </Tile>
          <Tile title={home.trust.points[4].title} body={home.trust.points[4].body} span={4} index={4}>
            <ArtScope slot="art" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.steps.headline} aside={home.steps.note}>
        <Bento>
          {
            home.steps.steps.map((step, i) => (
              <Tile kicker={step.number} title={step.title} body={step.body} span={4} index={i}>
                <ArtStep slot="art" kind={stepKinds[i]} />
              </Tile>
            ))
          }
        </Bento>
        <p class="mt-8 text-center reveal" style="--i:2">
          <a class="btn btn-primary" href={href(home.steps.cta.href)}>{home.steps.cta.label}</a>
        </p>
      </Band>

      <Band headline={home.audience.headline}>
        <Bento>
          {
            home.audience.points.map((point, i) => (
              <Tile title={point.title} body={point.body} span={4} index={i}>
                <ArtAudience slot="art" kind={audienceKinds[i]} />
              </Tile>
            ))
          }
        </Bento>
      </Band>

      <section class="section-default">
        <div class="mx-auto max-w-site px-5 text-center md:px-8">
          <h2 class="text-tp-heading mx-auto max-w-[720px] text-balance reveal">{home.social.headline}</h2>
          <p class="mx-auto mt-6 max-w-[560px] text-[15px] leading-relaxed text-ld-tertiary reveal" style="--i:1">
            {home.social.line} {home.social.invite}{' '}
            <a href={href(home.social.inviteHref)} class="text-white underline underline-offset-2">{home.social.inviteLabel}</a>
          </p>
        </div>
      </section>

      <CopyBlock headline={home.honesty.headline}>
        {home.honesty.paragraphs.map((p) => <p>{p}</p>)}
      </CopyBlock>

      <CTA
        headline={home.cta.headline}
        body={home.cta.body}
        primary={{ ...home.cta.primary, href: href(home.cta.primary.href) }}
        secondary={{ ...home.cta.secondary, href: href(home.cta.secondary.href) }}
      />
    </main>
  </AppShell>
</BaseLayout>
