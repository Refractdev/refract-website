---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../layouts/AppShell.astro';
import Hero from '@/components/sections/Hero.astro';
import CTA from '@/components/sections/CTA.astro';
import ResultNote from '@/components/sections/ResultNote.astro';
import Band from '@/components/ui/Band.astro';
import Bento from '@/components/ui/Bento.astro';
import Tile from '@/components/ui/Tile.astro';
import ArtDuplicate from '@/components/art/ArtDuplicate.astro';
import ArtFetch from '@/components/art/ArtFetch.astro';
import ArtLeftover from '@/components/art/ArtLeftover.astro';
import ArtStructure from '@/components/art/ArtStructure.astro';
import ArtApprove from '@/components/art/ArtApprove.astro';
import ArtOrder from '@/components/art/ArtOrder.astro';
import ArtCheck from '@/components/art/ArtCheck.astro';
import ArtProject from '@/components/art/ArtProject.astro';
import ArtQuiet from '@/components/art/ArtQuiet.astro';
import ArtDiff from '@/components/art/ArtDiff.astro';
import ArtMess from '@/components/art/ArtMess.astro';
import ArtCleanup from '@/components/art/ArtCleanup.astro';
import ArtConnect from '@/components/art/ArtConnect.astro';
import ArtRefuse from '@/components/art/ArtRefuse.astro';
import ArtScope from '@/components/art/ArtScope.astro';
import ArtStep from '@/components/art/ArtStep.astro';
import CommunityCard from '@/components/sections/CommunityCard.astro';
import Ships from '@/components/sections/Ships.astro';
import { DISCORD_URL, SIGNUP_PATH } from '@/lib/constants';
import { usePack } from '@/i18n/usePack';

const { pack, href } = usePack(Astro.url.pathname);
const { home, product } = pack;
const stepKinds = ['account', 'connect', 'ship'] as const;
const stepHrefs = ['/docs/account', '/docs/connect-github', '/docs/first-cleanup'] as const;
const trustHrefs = ['/docs/approve', undefined, undefined, '/docs/on-github', undefined] as const;
const worldStates = [
  { title: product.results.items[1].title, body: product.results.items[1].body },
  { title: product.results.items[2].title, body: product.results.items[2].body, action: product.results.items[2].title },
  { title: product.results.items[3].title, body: product.results.items[3].body },
];
const shipsItems = home.ships.items.map((item) => ({
  ...item,
  href: item.href.startsWith('http') ? item.href : href(item.href),
}));
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  ogTitle={home.seo.ogTitle}
  ogDescription={home.seo.ogDescription}
  includeProduct
>
  <AppShell>
    <main id="main">
      <Hero />

      <section class="band-section">
        <div class="mx-auto max-w-site px-5">
          <Bento>
            <Tile title={home.problem.bullets[0]} span={6} rows={2} index={0}>
              <ArtDuplicate slot="art" />
            </Tile>
            <Tile title={home.problem.bullets[1]} span={6} index={1}>
              <ArtFetch slot="art" />
            </Tile>
            <Tile title={home.problem.bullets[2]} span={3} index={2}>
              <ArtLeftover slot="art" />
            </Tile>
            <Tile title={home.problem.bullets[3]} span={3} index={3}>
              <ArtStructure slot="art" />
            </Tile>
          </Bento>
          <p class="band__after reveal" style="--i:1">
            {home.problem.close}
          </p>
        </div>
      </section>

      <Band
        variant="statement"
        headline={home.turn.headline}
        lede={home.turn.lede}
        more={{ label: home.turn.more.label, href: href(home.turn.more.href) }}
      />

      <Band headline={home.result.headline}>
        <Bento>
          <Tile title={home.result.points[0].title} body={home.result.points[0].body} span={8} index={0} href={href('/product')}>
            <ArtDiff slot="art" kind="remove" />
          </Tile>
          <Tile title={home.result.points[1].title} body={home.result.points[1].body} span={4} index={1} href={href('/product')}>
            <ArtDiff slot="art" kind="merge" />
          </Tile>
          <Tile title={home.result.points[2].title} body={home.result.points[2].body} span={4} index={2} href={href('/product')}>
            <ArtDiff slot="art" kind="add" />
          </Tile>
          <Tile title={home.result.points[3].title} body={home.result.points[3].body} span={8} index={3} href={href('/product')}>
            <ArtDiff slot="art" kind="lock" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.does.headline} more={{ label: home.does.more.label, href: href(home.does.more.href) }}>
        <Bento>
          <Tile kicker={home.does.points[0].number} title={home.does.points[0].title} body={home.does.points[0].body} span={5} index={0} href={href('/product')}>
            <ArtProject slot="art" />
          </Tile>
          <Tile kicker={home.does.points[1].number} title={home.does.points[1].title} body={home.does.points[1].body} span={7} index={1} href={href('/product')}>
            <ArtMess slot="art" />
          </Tile>
          <Tile kicker={home.does.points[2].number} title={home.does.points[2].title} body={home.does.points[2].body} span={7} index={2} href={href('/product')}>
            <ArtOrder slot="art" />
          </Tile>
          <Tile kicker={home.does.points[3].number} title={home.does.points[3].title} body={home.does.points[3].body} span={5} index={3} href={href('/product')}>
            <ArtCleanup slot="art" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.world.headline} lede={home.world.lede} after={home.world.close}>
        <Bento>
          <Tile span={8} body={home.world.caption} index={0} href={href('/docs/on-github')}>
            <ResultNote slot="art" states={worldStates} primaryIndex={1} />
          </Tile>
          <Tile body={home.world.decide} span={4} index={1} href={href('/docs/connect-github')}>
            <ArtConnect slot="art" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={home.trust.headline} more={{ label: home.ships.more.label, href: href('/docs/approve') }}>
        <Bento>
          <Tile title={home.trust.points[0].title} body={home.trust.points[0].body} span={7} size="tall" index={0} href={trustHrefs[0] ? href(trustHrefs[0]) : undefined}>
            <ArtApprove slot="art" />
          </Tile>
          <Tile title={home.trust.points[1].title} body={home.trust.points[1].body} span={5} size="tall" index={1}>
            <ArtQuiet slot="art" />
          </Tile>
          <Tile title={home.trust.points[2].title} body={home.trust.points[2].body} span={4} index={2}>
            <ArtRefuse slot="art" />
          </Tile>
          <Tile title={home.trust.points[3].title} body={home.trust.points[3].body} span={4} index={3} href={href('/docs/on-github')}>
            <ArtCheck slot="art" />
          </Tile>
          <Tile title={home.trust.points[4].title} body={home.trust.points[4].body} span={4} index={4}>
            <ArtScope slot="art" />
          </Tile>
        </Bento>
      </Band>

      <Band
        variant="centered"
        headline={home.steps.headline}
        aside={home.steps.note}
        more={{ label: home.steps.cta.label, href: href(home.steps.cta.href) }}
      >
        <Bento>
          {
            home.steps.steps.map((step, i) => (
              <Tile kicker={step.number} title={step.title} body={step.body} span={4} index={i} href={href(stepHrefs[i])}>
                <ArtStep slot="art" kind={stepKinds[i]} />
              </Tile>
            ))
          }
        </Bento>
      </Band>

      <Ships
        headline={home.ships.headline}
        more={{ label: home.ships.more.label, href: href(home.ships.more.href) }}
        items={shipsItems}
      />

      <Band variant="centered" headline={home.social.headline} lede={home.social.line}>
        <div class="community-grid">
          <CommunityCard
            compact
            brand="discord"
            kicker={home.social.discord.kicker}
            title={home.social.discord.title}
            body={home.social.discord.body}
            cta={home.social.discord.cta}
            href={DISCORD_URL}
          />
          <CommunityCard
            compact
            brand="github"
            kicker={home.social.github.kicker}
            title={home.social.github.title}
            body={home.social.github.body}
            cta={home.social.github.cta}
            href={href(SIGNUP_PATH)}
          />
        </div>
      </Band>

      <CTA
        headline={home.cta.headline}
        body={home.cta.body}
        primary={{ ...home.cta.primary, href: href(home.cta.primary.href) }}
        secondary={{ ...home.cta.secondary, href: href(home.cta.secondary.href) }}
      />
    </main>
  </AppShell>
</BaseLayout>
