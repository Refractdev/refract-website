---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../layouts/AppShell.astro';
import PageShell from '@/components/sections/PageShell.astro';
import { usePack } from '@/i18n/usePack';

const { pack, html } = usePack(Astro.url.pathname);
const { privacy } = pack.legal;
---

<BaseLayout title={privacy.title} description={privacy.description}>
  <AppShell variant="minimal">
    <PageShell label={pack.ui.legalLabel} title={privacy.headline}>
      <div class="prose-copy">
        <p class="docs-lede">{privacy.status}</p>
        <p>{privacy.operator}</p>
        <h2>{pack.ui.shortVersion}</h2>
        {privacy.short.map((p) => <p>{p}</p>)}
        <h2>{privacy.collectHeadline}</h2>
        <p>{privacy.collect}</p>
        <h2>{pack.ui.contactHeading}</h2>
        <p set:html={html(privacy.contactHtml)} />
        <h2>{pack.ui.changesHeading}</h2>
        <p>{privacy.changes}</p>
      </div>
    </PageShell>
  </AppShell>
</BaseLayout>
