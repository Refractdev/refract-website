---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../layouts/AppShell.astro';
import Pricing from '@/components/sections/Pricing.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CopyBlock from '@/components/sections/CopyBlock.astro';
import { breadcrumbSchema, faqPageSchema } from '@/lib/schema';
import { usePack } from '@/i18n/usePack';
import { localizeHref } from '@/i18n/href';

const { locale, pack } = usePack(Astro.url.pathname);
const { pricing, ui } = pack;
const schema = [
  faqPageSchema(pricing.faqs),
  breadcrumbSchema([
    { name: ui.homeCrumb, path: localizeHref('/', locale) },
    { name: pricing.seo.title.split('—')[0].trim(), path: localizeHref('/pricing/', locale) },
  ]),
];
---

<BaseLayout
  title={pricing.seo.title}
  description={pricing.seo.description}
  ogTitle={pricing.seo.ogTitle}
  ogDescription={pricing.seo.ogDescription}
  schema={schema}
>
  <AppShell>
    <main id="main">
      <section class="pt-32 pb-8">
        <div class="mx-auto max-w-site px-5 md:px-6">
          <div class="anim-hero max-w-[720px] text-left">
            <h1 class="text-tp-heading text-balance">{pricing.hero.headline}</h1>
            <p class="text-tp-desc mt-4 max-w-[560px]">{pricing.hero.subhead}</p>
            <p class="mt-3 max-w-[560px] text-[13px] leading-relaxed text-ld-muted">{pricing.hero.priceLine}</p>
          </div>
        </div>
      </section>
      <Pricing />
      <CopyBlock headline={pricing.value.headline}>
        {pricing.value.paragraphs.map((p) => <p>{p}</p>)}
      </CopyBlock>
      <FAQ items={pricing.faqs} title={pack.faq.title} />
    </main>
  </AppShell>
</BaseLayout>
