---
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';

interface Props {
  variant?: 'marketing' | 'minimal' | 'docs';
}

const { variant = 'marketing' } = Astro.props;
const headerVariant = variant === 'docs' ? 'marketing' : variant;
---

<div class="min-h-screen bg-ld-canvas">
  <Header variant={headerVariant} />
  <slot />
  <Footer />
</div>

<script is:inline>
  // Reveals fire once. Tiles stay observed for their whole life, because the
  // diagrams inside them loop and must not keep running off screen.
  (function () {
    // Marks the document as scripted; the reveal styles only hide content
    // once this class is present, so no-JS still renders everything.
    document.documentElement.classList.add('js');

    var timeline = window.CSS && CSS.supports && CSS.supports('animation-timeline', 'view()');
    var tiles = [].slice.call(document.querySelectorAll('.tile'));
    var reveals = timeline ? [] : [].slice.call(document.querySelectorAll('.reveal, .film--scroll'));

    if (!('IntersectionObserver' in window)) {
      tiles.concat(reveals).forEach(function (el) {
        el.classList.add('is-in');
        el.classList.add('is-live');
      });
      return;
    }

    if (reveals.length) {
      var once = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            once.unobserve(entry.target);
          });
        },
        { rootMargin: '120px 0px 18% 0px', threshold: 0.01 }
      );
      reveals.forEach(function (el) { once.observe(el); });
    }

    if (tiles.length) {
      // .is-in is the one-way reveal latch; .is-live gates animation-play-state.
      var live = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) entry.target.classList.add('is-in');
            entry.target.classList.toggle('is-live', entry.isIntersecting);
          });
        },
        { rootMargin: '120px 0px 18% 0px', threshold: 0.01 }
      );
      tiles.forEach(function (el) { live.observe(el); });

      // A backgrounded tab should not be paying for twenty loops either.
      document.addEventListener('visibilitychange', function () {
        var hidden = document.hidden;
        tiles.forEach(function (el) {
          if (hidden) el.classList.remove('is-live');
          else if (el.classList.contains('is-in')) el.classList.add('is-live');
        });
      });
    }
  })();

  // The header gains its hairline only once the page has actually moved.
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    var ticking = false;
    function apply() {
      header.setAttribute('data-scrolled', window.scrollY > 8 ? 'true' : 'false');
      ticking = false;
    }
    apply();
    window.addEventListener(
      'scroll',
      function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(apply);
      },
      { passive: true }
    );
  })();
</script>
