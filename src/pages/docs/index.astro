---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../layouts/AppShell.astro';
import PageShell from '@/components/sections/PageShell.astro';
import { docsHome, docsSeo } from '@/content/docs';
import { breadcrumbSchema } from '@/lib/schema';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Docs', path: '/docs/' },
  ]),
];
---

<BaseLayout title={docsSeo.title} description={docsSeo.description} schema={schema}>
  <AppShell>
    <PageShell label="Documentation" title={docsHome.headline} description={docsHome.intro} maxWidth={900}>
      {
        docsHome.groups.map((group, g) => (
          <section class="reveal" style={`--i:${g}`}>
            <h2 class="text-lg font-medium text-white">{group.title}</h2>
            <div class="mt-4">
              {group.links.map((link, i) => (
                <a href={link.href} class="docs-link">
                  {group.title === 'Start here' ? (
                    <span class="tp-mono w-5 shrink-0">{i + 1}.</span>
                  ) : null}
                  <span>{link.label}</span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </PageShell>
  </AppShell>
</BaseLayout>
