---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../layouts/AppShell.astro';
import Pricing from '@/components/sections/Pricing.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CopyBlock from '@/components/sections/CopyBlock.astro';
import { pricingFaqs, pricingHero, pricingSeo, pricingValue } from '@/content/pricing';
import { faqPageSchema } from '@/lib/schema';

const schema = [faqPageSchema(pricingFaqs)];
---

<BaseLayout
  title={pricingSeo.title}
  description={pricingSeo.description}
  ogTitle={pricingSeo.ogTitle}
  ogDescription={pricingSeo.ogDescription}
  schema={schema}
>
  <AppShell>
    <main id="main">
      <section class="pt-32 pb-8">
        <div class="mx-auto max-w-site px-5 md:px-6">
          <div class="anim-hero mx-auto max-w-[720px] text-center">
            <h1 class="text-tp-heading text-balance">{pricingHero.headline}</h1>
            <p class="text-tp-desc mx-auto mt-4 max-w-[560px]">{pricingHero.subhead}</p>
          </div>
        </div>
      </section>
      <Pricing />
      <CopyBlock headline={pricingValue.headline}>
        {pricingValue.paragraphs.map((p) => <p>{p}</p>)}
      </CopyBlock>
      <FAQ items={pricingFaqs} title="" />
    </main>
  </AppShell>
</BaseLayout>
