---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../layouts/AppShell.astro';
import FAQ from '@/components/sections/FAQ.astro';
import Band from '@/components/ui/Band.astro';
import Bento from '@/components/ui/Bento.astro';
import Tile from '@/components/ui/Tile.astro';
import ArtProject from '@/components/art/ArtProject.astro';
import ArtMess from '@/components/art/ArtMess.astro';
import ArtCleanup from '@/components/art/ArtCleanup.astro';
import ArtCheck from '@/components/art/ArtCheck.astro';
import ArtPlaces from '@/components/art/ArtPlaces.astro';
import ArtStatus from '@/components/art/ArtStatus.astro';
import {
  productCleans,
  productFaqs,
  productHero,
  productLoop,
  productPlaces,
  productResults,
  productSeo,
  productStart,
} from '@/content/product';
import { faqPageSchema } from '@/lib/schema';

const resultKinds = ['working', 'clear', 'ready', 'look', 'wrong'] as const;
const schema = [faqPageSchema(productFaqs)];
---

<BaseLayout
  title={productSeo.title}
  description={productSeo.description}
  ogTitle={productSeo.ogTitle}
  ogDescription={productSeo.ogDescription}
  schema={schema}
>
  <AppShell>
    <main id="main">
      <section class="relative overflow-hidden pb-16 pt-[128px] md:pb-24 md:pt-[160px]">
        <div class="atmosphere" aria-hidden="true"></div>
        <div class="relative z-10 mx-auto max-w-site px-5 md:px-8">
          <div class="anim-hero mx-auto max-w-[720px] text-center">
            <h1 class="text-tp-heading text-balance">{productHero.headline}</h1>
            <p class="text-hero-lede mx-auto mt-5 max-w-[600px]">{productHero.subhead}</p>
            <a href={productHero.cta.href} class="btn btn-primary btn-lg mt-8">{productHero.cta.label}</a>
          </div>
        </div>
      </section>

      <Band headline={productLoop.headline}>
        <Bento>
          <Tile kicker={productLoop.beats[0].number} title={productLoop.beats[0].title} body={productLoop.beats[0].body} span={7} size="tall" index={0}>
            <ArtProject slot="art" />
          </Tile>
          <Tile kicker={productLoop.beats[1].number} title={productLoop.beats[1].title} body={productLoop.beats[1].body} span={5} size="tall" index={1}>
            <ArtMess slot="art" />
          </Tile>
          <Tile kicker={productLoop.beats[2].number} title={productLoop.beats[2].title} body={productLoop.beats[2].body} span={5} index={2}>
            <ArtCleanup slot="art" />
          </Tile>
          <Tile kicker={productLoop.beats[3].number} title={productLoop.beats[3].title} body={productLoop.beats[3].body} span={7} index={3}>
            <ArtCheck slot="art" />
          </Tile>
        </Bento>
      </Band>

      <Band headline={productPlaces.headline} after={productPlaces.close}>
        <Bento>
          <Tile title={productPlaces.columns.github.title} span={6} index={0}>
            <ArtPlaces slot="art" side="github" items={productPlaces.columns.github.items} />
          </Tile>
          <Tile title={productPlaces.columns.web.title} span={6} index={1}>
            <ArtPlaces slot="art" side="web" items={productPlaces.columns.web.items} />
          </Tile>
        </Bento>
      </Band>

      <Band headline={productResults.headline}>
        <Bento>
          {
            productResults.items.map((item, i) => (
              <Tile title={item.title} body={item.body} span={i < 3 ? 4 : 6} size="short" index={i}>
                <ArtStatus slot="art" kind={resultKinds[i]} />
              </Tile>
            ))
          }
        </Bento>
      </Band>

      <Band headline={productCleans.headline} lede={productCleans.body} after={productCleans.close}>
        <Bento>
          {
            productCleans.bullets.map((item, i) => (
              <Tile title={item} span={4} index={i} />
            ))
          }
        </Bento>
      </Band>

      <Band headline={productStart.headline} aside={productStart.note}>
        <Bento>
          {
            productStart.steps.map((step, i) => (
              <Tile kicker={String(i + 1)} title={step} span={4} index={i} />
            ))
          }
        </Bento>
        <p class="mt-8 text-center reveal" style="--i:1">
          <a class="btn btn-primary" href={productStart.cta.href}>{productStart.cta.label}</a>
        </p>
      </Band>

      <FAQ items={productFaqs} title="" />
    </main>
  </AppShell>
</BaseLayout>
